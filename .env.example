# Compose 项目名（容器名前缀以此为准，与 compose 顶层 name 保持一致）
COMPOSE_PROJECT_NAME=patrolloop

# PostgreSQL
POSTGRES_DB=patrolloop
POSTGRES_USER=patrolloop
POSTGRES_PASSWORD=patrolloop_pass

# Django
DJANGO_SECRET_KEY=please-change-this-secret-in-production
DJANGO_DEBUG=false

# 超期扫描间隔（秒），调度服务会周期性生成升级单
SCAN_INTERVAL_SECONDS=600
